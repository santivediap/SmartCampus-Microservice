# TEMPLATE ONLY — the real Secret is never committed.
# The ".example" extension keeps "kubectl apply -f k8s/" from applying it.
#
# CI/CD: the deploy-minikube job creates it from the DB_PASSWORD GitHub Secret.
# Manual run:
#   kubectl -n smartcampus create secret generic smartcampus-secret \
#     --from-literal=DB_USER=smartcampus \
#     --from-literal=DB_PASSWORD='<password>'
#
# Note: Secret values are only base64-encoded, not encrypted.
apiVersion: v1
kind: Secret
metadata:
  name: smartcampus-secret
  namespace: smartcampus
type: Opaque
stringData:
  DB_USER: smartcampus
  DB_PASSWORD: CHANGE_ME
